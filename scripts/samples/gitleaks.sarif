{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "semanticVersion": "8.18.0",
          "rules": [
            { "id": "aws-access-token", "shortDescription": { "text": "AWS Access Token" } },
            { "id": "private-key", "shortDescription": { "text": "Private Key" } },
            { "id": "generic-api-key", "shortDescription": { "text": "Generic API Key" } }
          ]
        }
      },
      "results": [
        {
          "ruleId": "aws-access-token",
          "level": "error",
          "message": { "text": "Обнаружен AWS Access Token в коде." },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "deploy/terraform/main.tf" }, "region": { "startLine": 12, "endLine": 12, "snippet": { "text": "access_key = \"AKIAIOSFODNN7EXAMPLE\"" } } } }],
          "partialFingerprints": { "primaryLocationLineHash": "gl-aws-001" }
        },
        {
          "ruleId": "private-key",
          "level": "error",
          "message": { "text": "Обнаружен приватный ключ RSA." },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "certs/server.key" }, "region": { "startLine": 1, "endLine": 1, "snippet": { "text": "-----BEGIN RSA PRIVATE KEY-----" } } } }],
          "partialFingerprints": { "primaryLocationLineHash": "gl-pk-002" }
        },
        {
          "ruleId": "generic-api-key",
          "level": "error",
          "message": { "text": "Обнаружен generic API-ключ." },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "src/config.js" }, "region": { "startLine": 5, "endLine": 5, "snippet": { "text": "const apiKey = 'sk_live_abcd1234'" } } } }],
          "partialFingerprints": { "primaryLocationLineHash": "gl-api-003" }
        }
      ]
    }
  ]
}
