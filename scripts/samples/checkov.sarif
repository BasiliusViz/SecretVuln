{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Checkov",
          "semanticVersion": "3.2.0",
          "rules": [
            { "id": "CKV_AWS_20", "shortDescription": { "text": "S3 Bucket не должен быть публичным" } },
            { "id": "CKV_AWS_21", "shortDescription": { "text": "S3 Bucket должен иметь версионирование" } },
            { "id": "CKV_K8S_8", "shortDescription": { "text": "Liveness Probe должен быть настроен" } }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CKV_AWS_20",
          "level": "error",
          "message": { "text": "S3-бакет 'data-bucket' разрешает публичный доступ на чтение." },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "terraform/s3.tf" }, "region": { "startLine": 3, "endLine": 10 } } }],
          "properties": { "severity": "high" },
          "partialFingerprints": { "primaryLocationLineHash": "ckv-001" }
        },
        {
          "ruleId": "CKV_AWS_21",
          "level": "warning",
          "message": { "text": "У S3-бакета 'data-bucket' не включено версионирование." },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "terraform/s3.tf" }, "region": { "startLine": 3, "endLine": 10 } } }],
          "properties": { "severity": "low" },
          "partialFingerprints": { "primaryLocationLineHash": "ckv-002" }
        },
        {
          "ruleId": "CKV_K8S_8",
          "level": "warning",
          "message": { "text": "У контейнера 'api' не настроен liveness probe." },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "k8s/deployment.yaml" }, "region": { "startLine": 25 } } }],
          "properties": { "severity": "medium" },
          "partialFingerprints": { "primaryLocationLineHash": "ckv-003" }
        }
      ]
    }
  ]
}
