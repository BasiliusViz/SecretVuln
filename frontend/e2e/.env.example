# Учётки изолированного стенда UI-тестов (БД secretvuln_e2e, пересоздаётся на каждый прогон).
# Чтобы переопределить — скопируйте в e2e/.env (он в .gitignore).
SV_E2E_ADMIN_EMAIL=e2e-admin@secretvuln.local
SV_E2E_ADMIN_PASSWORD=E2eAdmin12345!
# Пароль пользователей без прав, которых тесты создают сами (user-…@e2e.local)
SV_E2E_USER_PASSWORD=E2eUser12345!
