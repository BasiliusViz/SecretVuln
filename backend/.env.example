# Copy to .env for local development. All vars use the SV_ prefix.
SV_DEBUG=true
SV_DATABASE_URL=postgresql+asyncpg://secretvuln:secretvuln@localhost:5432/secretvuln
SV_REDIS_URL=redis://localhost:6379/0
# Порт 9002, не 9000: на Windows localhost:9000 может перехватывать wslrelay.exe
SV_S3_ENDPOINT_URL=http://localhost:9002
SV_S3_ACCESS_KEY=minioadmin
SV_S3_SECRET_KEY=minioadmin
SV_S3_BUCKET=sarif-imports
SV_JWT_SECRET=dev-secret-do-not-use-in-prod
# LDAP — дефолты в config.py настроены на dev-контейнер lldap (docker compose up -d ldap).
# Переопредели под свой LDAP/AD:
# SV_LDAP_ENABLED=true
# SV_LDAP_SERVER=ldap://ldap.example.com:389
# SV_LDAP_BIND_DN=cn=svc-secretvuln,ou=services,dc=example,dc=com
# SV_LDAP_BIND_PASSWORD=...
# SV_LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=com
# SV_LDAP_USER_FILTER=(mail={email})
# SV_LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=com
