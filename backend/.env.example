# Copy to .env for local development. All vars use the SV_ prefix.
SV_DEBUG=true
SV_DATABASE_URL=postgresql+asyncpg://secretvuln:secretvuln@localhost:5432/secretvuln
SV_REDIS_URL=redis://localhost:6379/0
# Хранилище SARIF: local (папка) или s3
SV_STORAGE_BACKEND=local
SV_STORAGE_PATH=./data/sarif
# Для s3:
# Порт 9002, не 9000: на Windows localhost:9000 может перехватывать wslrelay.exe
SV_S3_ENDPOINT_URL=http://localhost:9002
SV_S3_ACCESS_KEY=minioadmin
SV_S3_SECRET_KEY=minioadmin
SV_S3_BUCKET=sarif-imports

# Справочники обогащения (EPSS, KEV, БДУ, CWE): предельный размер файла, МБ
SV_INTEL_MAX_MB=1024

SV_JWT_SECRET=dev-secret-do-not-use-in-prod
# LDAP — дефолты в config.py настроены на dev-контейнер lldap (docker compose up -d ldap).
# Переопредели под свой LDAP/AD:
# SV_LDAP_ENABLED=true
# SV_LDAP_SERVER=ldap://ldap.example.com:389
# SV_LDAP_BIND_DN=cn=svc-secretvuln,ou=services,dc=example,dc=com
# SV_LDAP_BIND_PASSWORD=...
# SV_LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=com
# SV_LDAP_USER_FILTER=(mail={email})
# SV_LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=com

# MCP-сервер для агентов (python -m app.mcp_server), авторизация — API-токен sv_…
# SV_MCP_HOST=127.0.0.1
# SV_MCP_PORT=8002

# Встроенный ИИ: любой OpenAI-совместимый /v1/chat/completions (Ollama, vLLM, шлюз, облако).
# Пустой SV_AI_BASE_URL — встроенный ИИ выключен.
# SV_AI_BASE_URL=http://localhost:11434/v1
# SV_AI_API_KEY=
# SV_AI_MODEL=
# SV_AI_TIMEOUT=60
# Сколько новых находок одного импорта разбирать автоматически; 0 — автозапуск выключен
# SV_AI_AUTO_LIMIT=50
# Эмбеддинги («Похожие находки», поиск по смыслу): OpenAI-совместимый /v1/embeddings.
# Пустая SV_AI_EMBED_MODEL — векторы выключены. Адрес по умолчанию — SV_AI_BASE_URL, ключ общий.
# SV_AI_EMBED_MODEL=bge-m3
# SV_AI_EMBED_BASE_URL=
# Размерность должна совпадать с колонкой vector(1024); другая — нужна новая миграция
# SV_AI_EMBED_DIM=1024
